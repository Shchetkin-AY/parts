{
  "name": "parts",
  "version": "1.0.0",
  "description": "Cars parts site",
  "type": "module",
  "scripts": {
    "prebuild": "npm run lint && npm run lint:css",
    "build": "vite build",
    "build:sync": "pnpm run build",
    "postbuild": "pnpm run sync:catalog",
    "start": "vite --force",
    "sync:catalog": "pnpm exec tsx scripts/sync-catalog.ts",
    "sync:sheet": "pnpm run sync:catalog",
    "check-types": "tsc --pretty --noEmit",
    "lint": "pnpm exec eslint src",
    "lint:fix": "pnpm exec eslint src --fix",
    "lint:inspect": "pnpm exec @eslint/config-inspector",
    "lint:css": "stylelint src/**/*.scss",
    "lint:css:fix": "stylelint src/**/*.scss --fix",
    "deploy": "pnpm run build",
    "r": "npm run release",
    "d": "npm run deploy"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "autoprefixer": "^10.4.27",
    "eslint": "10.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "pinia": "^3.0.4",
    "postcss": "^8.5.8",
    "postcss-scss": "^4.0.9",
    "sass": "^1.98.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.2",
    "vite-plugin-pwa": "^1.2.0",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  }
}